+--- Returns the node captured under the given capture argument. Neovim 0.12 dropped the
+--- `all` option from add_{predicate,directive}, so handlers now always receive a list of
+--- nodes per capture id; older versions handed over a single node.
+---@param captured TSNode|TSNode[]|nil
+---@return TSNode|nil
+local function capture_node(captured)
+	if type(captured) == "table" then
+		return captured[1]
+	end
+	return captured
+end
